{
  "name": "@lojas-tropical/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./legacy-catalog.json": "./data/legacy-catalog.json"
  },
  "scripts": {
    "legacy:extract": "node scripts/extract-legacy.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx scripts/check-parity.ts"
  },
  "dependencies": {
    "@lojas-tropical/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
