# Copie para apps/web/.env.local e packages/database/.env e preencha. NUNCA versione valores reais.

# --- Em uso agora ---
# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true SOMENTE em produção (libera o Google)
NEXT_PUBLIC_ALLOW_INDEXING=false
# PostgreSQL (packages/database). Local: docker compose up -d postgres
DATABASE_URL=postgresql://lojas:lojas_dev@localhost:5432/lojas_tropical_dev
# Supabase: use o "Session pooler" e termine com ?schema=loja (ver SUPABASE.md). Nunca no Git.
# Fonte do catálogo da vitrine: "database" lê o PostgreSQL; vazio usa o retrato JSON do site original.
CATALOG_SOURCE=

# --- Etapa 6: ERP ---
SOLIDUS_API_BASE_URL=https://smart.sgisistemas.com.br/api_produto/<empresa>/consultas/
SOLIDUS_TOKEN=
REDIS_URL=redis://localhost:6379

# --- Etapa 7: contas (Auth.js) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Etapa 8: Mercado Pago (use credenciais de TESTE fora de produção) ---
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Imagens e monitoramento ---
CLOUDINARY_URL=
SENTRY_DSN=
